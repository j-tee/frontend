# Local Development with Production Backend
# Use this file when you want to develop locally but connect to production API
# To use: Copy this file to .env.local
# Priority: .env.local > .env.production > .env

VITE_API_BASE_URL=https://posbackend.alphalogiquetechnologies.com
VITE_BYPASS_SUBSCRIPTION_CHECK=true

# Warehouse Transfer System Feature Flag
VITE_USE_NEW_TRANSFER_API=true
