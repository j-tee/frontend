# Development Environment Configuration
# This file is used for local development only
# For production, see .env.production

VITE_API_BASE_URL=http://localhost:8000
VITE_BYPASS_SUBSCRIPTION_CHECK=true

# Warehouse Transfer System Feature Flag
# Set to 'true' to use new batch warehouse transfer API
# Set to 'false' to use legacy stock adjustment API (default for safety)
VITE_USE_NEW_TRANSFER_API=true

# Paystack Configuration
# Public key for frontend display only - NO payment logic on frontend
# All payment processing happens on backend
VITE_PAYSTACK_PUBLIC_KEY=pk_test_5309f5af38555dbf7ef47287822ef2c6d3019b9d


